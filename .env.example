# Copy to .env.local for local development. Never commit real values.
# Local values come from `npm run supabase:status` after `npm run supabase:start`.
# On Netlify these are set under Project configuration › Environment variables.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
