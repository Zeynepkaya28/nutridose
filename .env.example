# Copy to .env.local for local development. Never commit real values.
# Local values come from `npm run supabase:status` after `npm run supabase:start`.
# On Vercel these are filled in by the Supabase Marketplace integration.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
